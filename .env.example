# Copy to .env (never commit .env). Keys are only read by the server (server/index.mjs);
# they are never sent to the browser.

# Voice (text to speech) and pronunciation practice (speech to text). Required for real AI voice.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI translator (Claude). Recommended. Get one at https://console.anthropic.com/settings/keys
# If it is empty but OPENAI_API_KEY is set, the translator uses OpenAI instead.
ANTHROPIC_API_KEY=

# Optional overrides
# TRANSLATE_PROVIDER=anthropic        # anthropic | openai
# TRANSLATE_MODEL=claude-opus-5-5     # default: claude-opus-5-5 (anthropic) / gpt-4.1 (openai)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-transcribe
# TTS_VOICE_MAIN=coral
# TTS_VOICE_PARTNER=ash
# PORT=8787

# Optional access code for a shared test link. When set, translation, AI voice and pronunciation
# ask for this code once per device (stored on the device). Leave empty for open access.
# ACCESS_CODE=
