# Copy to .env.ios before "npm run ios:sync".
# Public URL of the deployed SIDEYE server (npm run serve on Render, Railway, Fly.io...).
# The iOS app has no server of its own: translation, AI voice and pronunciation go here.
# No secrets in this file: it ends up inside the app bundle.
VITE_API_BASE=https://sideye.onrender.com
